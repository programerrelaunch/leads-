{
  "version": 2,
  "builds": [
    { "src": "api/search.js", "use": "@vercel/node" },
    { "src": "hub/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/search", "dest": "api/search.js" },
    { "src": "/", "dest": "hub/index.html" },
    { "src": "/(.+)", "dest": "hub/$1" }
  ],
  "cleanUrls": true
}
